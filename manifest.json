{
  "manifest_version": 3,
  "name": "Simple SEO Meta Checker",
  "version": "1.0.0",
  "description": "Instantly inspect a page's SEO metadata: title, description, canonical, headings, Open Graph, Twitter cards, images, links and structured data.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEO Meta Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
